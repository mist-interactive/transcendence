    {
      "name": "register new user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueId = Date.now();",
              "pm.environment.set(\"testUsername\", `user_${uniqueId}`);",
              "pm.environment.set(\"testEmail\", `user_${uniqueId}@test.postman`);",
              "pm.environment.set(\"testPassword\", \"Pass1234!\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register"
          ]
        }
      },
      "response": []
    },
