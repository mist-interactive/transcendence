    {
      "name": "token for user 1 Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is below 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response is valid JSON\", function () {",
              "    pm.expect(response).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"Response has a token\", function () {",
              "    pm.expect(response).to.have.property(\"token\");",
              "    pm.expect(response.token).to.be.a(\"string\").and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Token is a valid JWT (three segments)\", function () {",
              "    pm.expect(response.token.split(\".\")).to.have.lengthOf(3);",
              "});",
              "",
              "const token = response.token;",
              "",
              "if (token) {",
              "    const payloadBase64 = token.split('.')[1];",
              "    const decodedPayload = JSON.parse(Buffer.from(payloadBase64, 'base64').toString('utf-8'));",
              "    console.log(\"Decoded JWT Payload:\", decodedPayload);",
              "",
              "    pm.test(\"Token payload has an expiry (exp) claim\", function () {",
              "        pm.expect(decodedPayload).to.have.property(\"exp\");",
              "    });",
              "",
              "    pm.test(\"Token is not expired\", function () {",
              "        pm.expect(decodedPayload.exp * 1000).to.be.above(Date.now());",
              "    });",
              "",
              "    if (decodedPayload.exp) {",
              "        const expDate = new Date(decodedPayload.exp * 1000);",
              "        console.log(\"Token Expires At:\", expDate.toLocaleString());",
              "    }",
              "    pm.environment.set(\"tokenA\", token);",
              "} else {",
              "    console.warn(\"No token found in response body!\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
